[Unit]
Description=Eddie DNS server (port 53)
PartOf=eddie.target
After=network-online.target eddie-api.service

[Service]
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=@ENV@
# Port 53 without running as root; eddie.db stays owned by the same user as the API's.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ExecStart=@REPO@/.venv/bin/python -m eddie.dns_server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=eddie.target
